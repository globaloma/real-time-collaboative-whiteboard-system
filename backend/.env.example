PORT=5000
# Never set FLASK_DEBUG=1 in production — it enables the interactive debugger
# and the Werkzeug auto-reloader.
FLASK_DEBUG=0
LOG_LEVEL=INFO

# "threading" everywhere — local `python app.py` and production
# (gunicorn --worker-class gthread) both use it. See backend/README.md for why.
SOCKETIO_ASYNC_MODE=threading

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key

# Firebase Firestore persistence
FIREBASE_COLLECTION_NAME=whiteboard_rooms

# Use ONE of these:
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccountKey.json
# or
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", "...":"..."}